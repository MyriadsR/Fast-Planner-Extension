<launch>
  <!-- 动态立方体障碍物配置 -->
  <arg name="obs_num" default="5"/>
  <arg name="obs_max_speed" default="1.0"/>
  <arg name="freq" default="10.0"/>
  <arg name="resolution" default="0.2"/>

  <!-- 立方体尺寸范围 -->
  <arg name="size_min_x" default="0.5"/>
  <arg name="size_min_y" default="0.5"/>
  <arg name="size_min_z" default="0.5"/>

  <arg name="size_max_x" default="1.5"/>
  <arg name="size_max_y" default="1.5"/>
  <arg name="size_max_z" default="2.0"/>

  <!-- 可视化选项 -->
  <arg name="use_rviz" default="true"/>

  <!-- 启动动态立方体障碍物发布器 -->
  <node pkg="dynamic_obstacles" type="dynamic_cube_obstacles" name="dynamic_cube_obstacles" output="screen">
    <param name="world_frame" value="world"/>
    <param name="obs_num" value="$(arg obs_num)"/>
    <param name="obs_max_speed" value="$(arg obs_max_speed)"/>
    <param name="freq" value="$(arg freq)"/>
    <param name="resolution" value="$(arg resolution)"/>

    <param name="size_min_x" value="$(arg size_min_x)"/>
    <param name="size_min_y" value="$(arg size_min_y)"/>
    <param name="size_min_z" value="$(arg size_min_z)"/>

    <param name="size_max_x" value="$(arg size_max_x)"/>
    <param name="size_max_y" value="$(arg size_max_y)"/>
    <param name="size_max_z" value="$(arg size_max_z)"/>

    <!-- 点云发布到这个topic，可以被 pcl_render_node 或 sdf_map 订阅 -->
    <remap from="~cloud" to="/dynamic_obstacles/cloud"/>
    <remap from="~vis" to="/dynamic_obstacles/vis"/>
  </node>

  <!-- RViz 可视化（可选） -->
  <group if="$(arg use_rviz)">
    <node pkg="rviz" type="rviz" name="rviz"
          args="-d $(find dynamic_obstacles)/rviz/dynamic_obstacles.rviz"
          output="screen"/>
  </group>

</launch>
